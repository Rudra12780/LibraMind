# =========================================================================
# LIBRAMIND LMS - ENVIRONMENT CONFIGURATION
# =========================================================================

# Server Configuration
PORT=5001
JWT_SECRET=libramind_sanctuary_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:5000

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/libramind?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=libramind

# Email Delivery Configuration (SMTP)
# Configure these variables with your SMTP provider (Gmail, SendGrid, Mailgun, Ethereal, AWS SES, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LibraMind Library Sanctuary" <noreply@libramind.edu>

# Example Gmail configuration:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-library-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM="LibraMind Library" <your-library-email@gmail.com>

# Example Ethereal (Free testing SMTP):
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_USER=your-ethereal-user
# EMAIL_PASSWORD=your-ethereal-pass


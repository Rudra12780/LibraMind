# =========================================================================
# LIBRAMIND LMS - BACKEND ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to backend/.env for local dev or import into Render / Railway / Vercel
# =========================================================================

# Runtime & Server Configuration
NODE_ENV=production
PORT=5001
JWT_SECRET=<generate-a-long-random-secret-key>
FRONTEND_URL=https://<your-app>.vercel.app

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/libramind?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=libramind

# =========================================================================
# REAL SMS OTP GATEWAY CONFIGURATION (TWILIO OR MSG91)
# Required for Forgot Password 60-second SMS OTP verification
# =========================================================================
# Choose provider: "twilio" (default) or "msg91"
SMS_PROVIDER=twilio

# Option A: Twilio SMS Configuration
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number-e164>

# Option B: MSG91 SMS Configuration (set SMS_PROVIDER=msg91 above)
MSG91_AUTH_KEY=<your-msg91-auth-key>
MSG91_TEMPLATE_ID=<your-msg91-dlt-template-id>
MSG91_SENDER_ID=LIBRAM

# =========================================================================
# EMAIL DELIVERY CONFIGURATION (OPTIONAL SMTP)
# =========================================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LibraMind Library Sanctuary" <noreply@libramind.edu>

# =========================================================================
# LIBRAMIND FRONTEND (VERCEL) - ENVIRONMENT VARIABLES EXAMPLE
# Copy values into Vercel -> Project Settings -> Environment Variables
# (All keys must be safe placeholders here — never commit real secrets)
# =========================================================================

# Optional: Only needed if Backend is hosted separately (e.g. Render/Railway)
# Leave blank when deploying full-stack from root on Vercel (uses /api automatically)
VITE_API_URL=

# Firebase Authentication & Analytics (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=<your-firebase-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your-firebase-project-id>
VITE_FIREBASE_STORAGE_BUCKET=<your-project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
VITE_FIREBASE_APP_ID=<your-firebase-app-id>
VITE_FIREBASE_MEASUREMENT_ID=<your-google-analytics-measurement-id>
